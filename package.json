{
  "name": "agent-work-graph",
  "version": "0.1.0",
  "description": "Local-first Agent Work Graph CLI and compiler.",
  "type": "module",
  "bin": {
    "awg": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "schemas",
    "docs",
    "examples"
  ],
  "scripts": {
