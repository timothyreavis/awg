            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "type",
          "data"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "body": {
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "fields": {
