{
  "additionalProperties": true,
  "properties": {
    "awg": {
      "const": "0.1"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "from": {
      "pattern": "^n:.+",
      "type": "string"
    },
    "id": {
      "pattern": "^e:.+",
      "type": "string"
    },
    "kind": {
      "const": "edge"
    },
    "rel": {
      "enum": [
        "relates_to",
        "depends_on",
        "blocks",
        "supports",
        "duplicate_of",
        "canonical_for",
        "contradicts",
        "answers",
        "asks",
        "implements",
        "affects",
        "supersedes",
        "superseded_by",
        "resolved_by",
        "verified_by",
        "derived_from",
        "intentionally_open",
        "part_of",
        "caused_by",
        "requires",
        "recommends",
        "references",
        "owned_by",
        "applies_to"
      ]
    },
    "to": {
      "pattern": "^n:.+",
      "type": "string"
    }
  },
  "required": [
    "awg",
    "kind",
    "id",
    "from",
    "rel",
    "to",
    "created_at"
  ],
  "type": "object"
}
