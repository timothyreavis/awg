    "goal": null,
    "ok": true,
    "questions": [
      {
        "field": "purpose",
        "id": "purpose",
        "prompt": "What future work should this vault help agents perform?",
        "why": "Purpose keeps capture scoped."
      },
      {
        "field": "capture_policy",
        "id": "capture",
        "prompt": "Which decisions, facts, risks, and evidence will affect future work?",
        "why": "Agents need clear capture thresholds."
      },
      {
        "field": "non_capture_policy",
        "id": "non_capture",
        "prompt": "What should stay out of AWG or remain in source-of-truth systems?",
        "why": "Non-capture rules prevent transcript and private-data creep."
      },
      {
        "field": "sensitivity_rules",
        "id": "sensitivity",
        "prompt": "How should agents handle PII, private client context, finances, contracts, credentials, source-of-truth systems, redaction, and never-capture categories?",
        "why": "Client-pilot use needs explicit sensitive-data handling."
      },
      {
        "field": "approval_rules",
        "id": "approval",
        "prompt": "What requires human approval before being marked accepted, completed, published, or client-visible?",
        "why": "Approval boundaries keep agents from self-authorizing."
      }
    ],
    "sections": [
      {
        "id": "method",
        "items": [
          "Inspect existing AWG state and explicit user-provided context.",
          "Create or update one vault-local operating template.",
          "Keep new templates needs_review until human approval.",
          "Capture summarized rules and source-of-truth boundaries, not raw transcripts or private excerpts."
        ],
        "title": "Authoring Method"
      },
      {
        "id": "review",
        "items": [
          "Scaffolds are candidates, not settled policy.",
          "Client-pilot readiness requires reviewed and human_approved template fields.",
          "Doctor suggestions must not self-approve operating templates."
        ],
        "title": "Review Expectations"
      }
    ],
    "suggestedCommands": [
      "awg template scaffold --title 'Operating template' --goal '<goal>' --scope vault --json",
      "awg template status --goal '<goal>' --json",
      "awg vault readiness --goal '<goal>' --client-pilot --json"
    ],
    "warnings": [
      {
        "code": "AWG_TEMPLATE_NO_DOMAIN_PACKS",
        "message": "Create scenario-specific vault-local rules; do not search for a built-in domain pack.",
        "severity": "info"
      }
    ]
  },
